      "source": [
        "import math\n",
        "def neuron(x1, x2, w1, w2, b):\n",
        "  n = x1*w1 + x2*w2 + b\n",
        "  return math.tanh(n)\n",
        "\n",
        "n1 = neuron(3.0, 4.0, 2.0, 1.0, 2.0)\n",
        "n1\n",
        "\n",
        "n2 = neuron(3.0, 4.0 , -2.0, -1.0 , 5.0)\n",
        "n2\n",
        "\n",
        "n3 = neuron (3.0, 4.0 , 4.0 , 5.0 , 10.0)\n",
        "n3\n",
        "\n",
        "Layer = [n1, n2, n3]\n",
        "Layer\n"
      ]
