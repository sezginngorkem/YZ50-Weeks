      "source": [
        "b = 3.0\n",
        "d = 6.0\n",
        "hedef = 12.00\n",
        "\n",
        "\n",
        "def loss (a):\n",
        "  c = a*b\n",
        "  e = c+d\n",
        "  return (e - hedef)**2\n",
        "\n",
        "print (loss (2.0))\n",
        "print (loss (5.0))\n",
        "\n",
        "a= 5.0\n",
        "h= 0.0001\n",
        "adim = 0.01\n",
        "\n",
        "\n",
        "for i in range(30):\n",
        "\n",
        "  derivative = (loss (a + h) - loss (a)) / h\n",
        "  a = a - (adim * derivative)\n",
        "  print(i, a, loss(a))\n"
